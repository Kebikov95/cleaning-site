{
  "name": "cleaning-site",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт химчистки мягкой мебели «Чистый Диван» — HTML, CSS, JS",
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "html-validate \"*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1"
  }
}
